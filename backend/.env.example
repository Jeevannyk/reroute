# Copy this file to backend/.env and fill in your own key. backend/.env is gitignored. Never commit a key.
# Reroute reads settings ONLY from backend/.env; OS environment variables are ignored.
# Free key: https://aistudio.google.com/apikey
# The AI is optional: with no key, the plan explanation falls back to a fixed sentence.
GEMINI_API_KEY=

# Optional: model fallback chain, tried in order
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
